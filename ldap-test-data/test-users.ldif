# Test Users for LDAP Authentication Testing
# These users are created automatically when the OpenLDAP container starts

# Create Users OU
dn: ou=Users,dc=test,dc=local
objectClass: organizationalUnit
ou: Users

# Test User 1: testuser / password123
dn: cn=testuser,ou=Users,dc=test,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: testuser
sn: User
givenName: Test
uid: testuser
uidNumber: 1001
gidNumber: 1001
homeDirectory: /home/testuser
loginShell: /bin/bash
displayName: Test User
mail: testuser@test.local
userPassword: password123

# Test User 2: adminuser / admin123
dn: cn=adminuser,ou=Users,dc=test,dc=local
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: adminuser
sn: Admin
givenName: Admin
uid: adminuser
uidNumber: 1002
gidNumber: 1002
homeDirectory: /home/adminuser
loginShell: /bin/bash
displayName: Admin User
mail: adminuser@test.local
userPassword: admin123
