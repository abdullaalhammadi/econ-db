# Environment variables for testing with local OpenLDAP
# Copy these to your .env file or export them before running the backend

# LDAP Server (local Docker container)
LDAP_SERVER=ldap://localhost
LDAP_PORT=389
LDAP_USE_SSL=false

# Base DN for test.local domain
LDAP_BASE_DN=dc=test,dc=local
LDAP_USER_SEARCH_BASE=ou=Users,dc=test,dc=local

# Admin credentials for service account (optional, for searching)
LDAP_BIND_USER=cn=admin,dc=test,dc=local
LDAP_BIND_PASSWORD=adminpassword

# OpenLDAP uses 'uid' or 'cn' filter (not sAMAccountName like AD)
LDAP_USER_FILTER=(cn={username})

# No LDAP_DOMAIN for OpenLDAP (that's for AD NTLM)
LDAP_DOMAIN=

# OpenLDAP bind template - constructs full DN for user authentication
LDAP_USER_DN_TEMPLATE=cn={username},ou=Users,dc=test,dc=local

# OpenLDAP attribute names
LDAP_USERNAME_ATTR=cn
LDAP_DISPLAY_NAME_ATTR=displayName

# ============================================
# Test Credentials:
#   Username: testuser    Password: password123
#   Username: adminuser   Password: admin123
# ============================================
